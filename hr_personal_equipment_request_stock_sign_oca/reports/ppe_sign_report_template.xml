<odoo>
    <template
        id="ppe_sign_report_template"
        inherit_id="hr_personal_equipment_request_sign_oca.ppe_sign_report_template"
    >
        <!-- Show Serial Number after Product column -->
        <xpath expr="//table/thead//th[1]" position="after">
            <th t-if="doc.employee_id.company_id.ppe_report_show_sn">
                S/N
            </th>
        </xpath>
        <xpath expr="//table/tbody//td[1]" position="after">
            <td t-if="doc.employee_id.company_id.ppe_report_show_sn">
                <t t-out="line.move_ids.lot_ids.name" />
            </td>
        </xpath>
    </template>
</odoo>
